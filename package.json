{
  "name": "story-to-video-factory",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Topic/story, script, WAV or SRT to animated video with stick figure or robot actors",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "video-factory": "dist/apps/cli/index.js"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:asr": "tsx scripts/acceptance-asr.ts",
    "animation:preview": "tsx scripts/animation-preview.ts",
    "animation:serve": "tsx scripts/animation-player.ts",
    "cinematic:preview": "tsx scripts/cinematic-preview.ts",
    "test:render": "tsx scripts/acceptance-render.ts",
    "test:cinematic-inputs": "tsx scripts/acceptance-v22.ts",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "cli": "tsx apps/cli/index.ts",
    "build": "tsc -p tsconfig.json && tsc --noEmit -p apps/studio/tsconfig.json && vite build --config apps/studio/vite.config.ts",
    "build:core": "tsc -p tsconfig.json",
    "schemas": "tsx library/schemas/export.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/studio/tsconfig.json",
    "studio": "tsx apps/server/index.ts",
    "studio:dev": "vite --config apps/studio/vite.config.ts",
    "benchmark": "tsx benchmarks/run.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "gsap": "^3.13.0",
    "hyperframes": "0.8.96",
    "sharp": "^0.34.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "ajv": "8.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
