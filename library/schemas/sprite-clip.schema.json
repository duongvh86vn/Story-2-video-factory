{
  "$ref": "#/definitions/sprite-clip",
  "definitions": {
    "sprite-clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "compositionId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1
        },
        "placement": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 8
            },
            "rotation": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "x",
            "y",
            "scale",
            "rotation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "compositionId",
        "startMs",
        "endMs",
        "placement"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
