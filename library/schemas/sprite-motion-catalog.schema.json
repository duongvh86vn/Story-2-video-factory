{
  "$ref": "#/definitions/sprite-motion-catalog",
  "definitions": {
    "sprite-motion-catalog": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "actor-motion-catalog-1"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "motionId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "locomotion",
                        "manipulation",
                        "posture",
                        "observation",
                        "indication",
                        "speech",
                        "reaction",
                        "hold",
                        "unsupported"
                      ]
                    },
                    "movement": {
                      "type": "string",
                      "enum": [
                        "walk",
                        "run",
                        "jump"
                      ]
                    },
                    "operation": {
                      "type": "string",
                      "enum": [
                        "contact",
                        "pick-place",
                        "carry",
                        "drop",
                        "hold-tool",
                        "thrust-tool"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 16
              },
              "speechVariants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variantId": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "variantId",
                    "fingerprint"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "required": [
              "motionId",
              "fingerprint",
              "label",
              "capabilities"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "version",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
