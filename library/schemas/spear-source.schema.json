{
  "$ref": "#/definitions/spear-source",
  "definitions": {
    "spear-source": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "native-source-spear-1"
        },
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "kind": {
                "type": "string",
                "const": "spear"
              },
              "origin": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "attachedTo": {
                "type": "string",
                "enum": [
                  "left-hand",
                  "right-hand"
                ]
              },
              "length": {
                "type": "number",
                "minimum": 50,
                "maximum": 600
              },
              "gripOffset": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number",
                    "const": 0
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "origin",
              "attachedTo",
              "length",
              "gripOffset"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2
        },
        "spears": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "propId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "startMs": {
                "type": "number",
                "const": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 0
              },
              "hand": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "twoHand": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "enum": [
                  "hold",
                  "thrust"
                ]
              },
              "grip": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "aim": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "secondaryOffset": {
                "type": "number",
                "minimum": -200,
                "maximum": -10
              },
              "elbowPoles": {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "number",
                    "enum": [
                      -1,
                      1
                    ]
                  },
                  "right": {
                    "type": "number",
                    "enum": [
                      -1,
                      1
                    ]
                  }
                },
                "required": [
                  "left",
                  "right"
                ],
                "additionalProperties": false
              },
              "readyMs": {
                "type": "integer",
                "minimum": 0
              },
              "contactMs": {
                "type": "integer",
                "minimum": 0
              },
              "recoverMs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "propId",
              "startMs",
              "endMs",
              "hand",
              "twoHand",
              "action",
              "grip",
              "aim",
              "secondaryOffset",
              "elbowPoles"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2
        },
        "lunge": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "forest-planted-lunge-1"
            },
            "spearId": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
            },
            "soles": {
              "type": "object",
              "properties": {
                "left": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "right": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "left",
                "right"
              ],
              "additionalProperties": false
            },
            "kneePoles": {
              "type": "object",
              "properties": {
                "left": {
                  "type": "number",
                  "enum": [
                    -1,
                    1
                  ]
                },
                "right": {
                  "type": "number",
                  "enum": [
                    -1,
                    1
                  ]
                }
              },
              "required": [
                "left",
                "right"
              ],
              "additionalProperties": false
            },
            "advanceX": {
              "type": "number",
              "minimum": -20,
              "maximum": 20
            },
            "dropY": {
              "type": "number",
              "minimum": 0,
              "maximum": 12
            },
            "entryLeanDeg": {
              "type": "number",
              "minimum": -20,
              "maximum": 20
            },
            "contactLeanDeg": {
              "type": "number",
              "minimum": -25,
              "maximum": 25
            }
          },
          "required": [
            "version",
            "spearId",
            "soles",
            "kneePoles",
            "advanceX",
            "dropY",
            "entryLeanDeg",
            "contactLeanDeg"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "ownerId",
        "startMs",
        "endMs",
        "props",
        "spears"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
