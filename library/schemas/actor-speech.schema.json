{
  "$ref": "#/definitions/actor-speech",
  "definitions": {
    "actor-speech": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "actor-speech-1"
        },
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "actorId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "motionId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "motionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "view": {
          "type": "string",
          "enum": [
            "front",
            "back",
            "left",
            "right",
            "three-quarter-left",
            "three-quarter-right",
            "back-three-quarter-left",
            "back-three-quarter-right"
          ]
        },
        "referenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "properties": {
            "registrationHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "baseSheetHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "registrationHash",
            "baseSheetHash"
          ],
          "additionalProperties": false
        },
        "sheet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 32768
            }
          },
          "required": [
            "path",
            "hash",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "candidate"
            },
            "productionReady": {
              "type": "boolean",
              "const": false
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              },
              "maxItems": 32
            }
          },
          "required": [
            "status",
            "productionReady",
            "warnings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "actorId",
        "motionId",
        "motionFingerprint",
        "view",
        "referenceHash",
        "fingerprint",
        "source",
        "sheet",
        "regions",
        "review"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
