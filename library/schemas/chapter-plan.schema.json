{
  "$ref": "#/definitions/chapter-plan",
  "definitions": {
    "chapter-plan": {
      "type": "object",
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "narrativePurpose": {
                "type": "string",
                "minLength": 1
              },
              "segmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "title",
              "summary",
              "narrativePurpose",
              "segmentIds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "chapters"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
