{
  "$ref": "#/definitions/host-profile",
  "definitions": {
    "host-profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "mini-robot",
            "stick-man"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "explainer-host",
            "story-actor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24000
        },
        "appearance": {
          "type": "object",
          "properties": {
            "outline": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shell": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "screen": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "badge": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "headScale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.25
            },
            "bodyScale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.25
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 2,
              "maximum": 10
            },
            "characterVariant": {
              "type": "string",
              "enum": [
                "lila",
                "karo"
              ]
            },
            "artworkVersion": {
              "type": "string",
              "enum": [
                "forest-head-1",
                "forest-body-1",
                "forest-body-view-1"
              ]
            },
            "bodyView": {
              "type": "string",
              "enum": [
                "three-quarter-right",
                "three-quarter-left"
              ]
            },
            "bodyHeadBank": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "enum": [
                    "native-head-bank-1",
                    "native-head-bank-2"
                  ]
                },
                "id": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "actor": {
                  "type": "string",
                  "enum": [
                    "lila",
                    "karo"
                  ]
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "pattern": "^library\\/topics\\/prehistoric-life\\/(?:head-turn-studies\\/(?:lila|karo)-head-turn-v[1-9]\\d*|head-cells\\/(?:lila|karo)-head-[a-z0-9][a-z0-9-]{0,39}-v[1-9]\\d*)\\.png$(?![\\s\\S])"
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "width": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 8192
                    },
                    "pixelScale": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "file",
                    "sha256",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                "additionalSources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 96,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                      },
                      "file": {
                        "type": "string",
                        "pattern": "^library\\/topics\\/prehistoric-life\\/(?:head-turn-studies\\/(?:lila|karo)-head-turn-v[1-9]\\d*|head-cells\\/(?:lila|karo)-head-[a-z0-9][a-z0-9-]{0,39}-v[1-9]\\d*)\\.png$(?![\\s\\S])"
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "width": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 8192
                      },
                      "height": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 8192
                      },
                      "pixelScale": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 2
                      }
                    },
                    "required": [
                      "id",
                      "file",
                      "sha256",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 23
                },
                "primary": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "bodyViews": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "view": {
                        "type": "string",
                        "enum": [
                          "three-quarter-left",
                          "three-quarter-right"
                        ]
                      },
                      "sourceHash": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "view",
                      "sourceHash"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 2
                },
                "unitScale": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 2
                },
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 96,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                      },
                      "sourceId": {
                        "type": "string",
                        "maxLength": 96,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                      },
                      "crop": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "width": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "height": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      },
                      "neck": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "neckTop": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "chin": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "eyeTarget": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "skull": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "width": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "height": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      },
                      "yawDeg": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "seam": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 3,
                        "maxItems": 32
                      },
                      "restMood": {
                        "type": "string",
                        "enum": [
                          "neutral",
                          "happy"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "crop",
                      "neck",
                      "neckTop",
                      "chin",
                      "eyeTarget",
                      "skull",
                      "yawDeg",
                      "seam",
                      "restMood"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2,
                  "maxItems": 40
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "minItems": 2,
                    "maxItems": 40
                  },
                  "minItems": 1,
                  "maxItems": 40
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "speech": {
                      "type": "boolean",
                      "const": false
                    },
                    "directionalEyes": {
                      "type": "boolean",
                      "const": false
                    },
                    "expressions": {
                      "type": "boolean",
                      "const": false
                    },
                    "secondary": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "speech",
                    "directionalEyes",
                    "expressions",
                    "secondary"
                  ],
                  "additionalProperties": false
                },
                "status": {
                  "type": "string",
                  "const": "engineering-source-registration"
                },
                "approved": {
                  "type": "boolean",
                  "const": false
                },
                "productionReady": {
                  "type": "boolean",
                  "const": false
                },
                "motionVerified": {
                  "type": "boolean",
                  "const": false
                },
                "fingerprint": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "version",
                "id",
                "actor",
                "source",
                "primary",
                "bodyViews",
                "unitScale",
                "cells",
                "routes",
                "capabilities",
                "status",
                "approved",
                "productionReady",
                "motionVerified",
                "fingerprint"
              ],
              "additionalProperties": false
            },
            "bodySpeech": {
              "type": "string",
              "enum": [
                "registered-mouth-v1",
                "registered-rest-mouth-v1"
              ]
            },
            "bodyEyes": {
              "type": "string",
              "const": "registered-eyes-v1"
            },
            "bodyExpressions": {
              "type": "string",
              "const": "registered-expressions-v1"
            },
            "bodyMotion": {
              "type": "string",
              "const": "registered-locomotion-v1"
            },
            "bodySeat": {
              "type": "string",
              "const": "registered-seated-v1"
            },
            "bodySecondary": {
              "type": "string",
              "const": "registered-secondary-v1"
            },
            "sourceColour": {
              "type": "string",
              "const": "original-rgb-v2"
            }
          },
          "required": [
            "outline",
            "shell",
            "screen",
            "accent",
            "badge",
            "headScale",
            "bodyScale",
            "strokeWidth"
          ],
          "additionalProperties": false
        },
        "costume": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "joint": {
                "type": "string",
                "enum": [
                  "head",
                  "chest",
                  "pelvis",
                  "hand-left",
                  "hand-right"
                ]
              },
              "svg": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24000
              }
            },
            "required": [
              "joint",
              "svg"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "idle",
              "greet",
              "explain",
              "point",
              "operate-model",
              "compare",
              "think",
              "react",
              "summarize",
              "walk-to-marker"
            ]
          },
          "minItems": 1
        },
        "immutable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "profileHash": {
          "type": "string"
        },
        "compilerVersion": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "role",
        "name",
        "description",
        "appearance",
        "actions",
        "immutable",
        "profileHash",
        "compilerVersion",
        "sourcePath"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
