{
  "$ref": "#/definitions/host-profile",
  "definitions": {
    "host-profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "mini-robot",
            "stick-man"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "explainer-host",
            "story-actor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24000
        },
        "appearance": {
          "type": "object",
          "properties": {
            "outline": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shell": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "screen": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "badge": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "headScale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.25
            },
            "bodyScale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.25
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 2,
              "maximum": 10
            },
            "characterVariant": {
              "type": "string",
              "enum": [
                "lila",
                "karo"
              ]
            },
            "artworkVersion": {
              "type": "string",
              "enum": [
                "forest-head-1",
                "forest-body-1",
                "forest-body-view-1"
              ]
            },
            "bodyView": {
              "type": "string",
              "enum": [
                "three-quarter-right"
              ]
            }
          },
          "required": [
            "outline",
            "shell",
            "screen",
            "accent",
            "badge",
            "headScale",
            "bodyScale",
            "strokeWidth"
          ],
          "additionalProperties": false
        },
        "costume": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "joint": {
                "type": "string",
                "enum": [
                  "head",
                  "chest",
                  "pelvis",
                  "hand-left",
                  "hand-right"
                ]
              },
              "svg": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24000
              }
            },
            "required": [
              "joint",
              "svg"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "idle",
              "greet",
              "explain",
              "point",
              "operate-model",
              "compare",
              "think",
              "react",
              "summarize",
              "walk-to-marker"
            ]
          },
          "minItems": 1
        },
        "immutable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "profileHash": {
          "type": "string"
        },
        "compilerVersion": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "role",
        "name",
        "description",
        "appearance",
        "actions",
        "immutable",
        "profileHash",
        "compilerVersion",
        "sourcePath"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
