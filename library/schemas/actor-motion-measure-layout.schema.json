{
  "$ref": "#/definitions/actor-motion-measure-layout",
  "definitions": {
    "actor-motion-measure-layout": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "actor-motion-measure-layout-1"
        },
        "sheetHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "w": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "rect": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "w": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "h": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "rect"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32,
                "default": []
              }
            },
            "required": [
              "id",
              "rect"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "version",
        "sheetHash",
        "frames"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
