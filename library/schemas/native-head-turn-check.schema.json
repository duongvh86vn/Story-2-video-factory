{
  "$ref": "#/definitions/native-head-turn-check",
  "definitions": {
    "native-head-turn-check": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "enum": [
                "lila",
                "karo"
              ]
            },
            "file": {
              "type": "string",
              "pattern": "^(lila|karo)-head-turn-v[1-9]\\d*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "materialFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "actor",
            "file",
            "sha256",
            "materialFingerprint",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "draft": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "native-head-turn-landmarks-1"
            },
            "actor": {
              "type": "string",
              "enum": [
                "lila",
                "karo"
              ]
            },
            "file": {
              "type": "string",
              "pattern": "^(lila|karo)-head-turn-v[1-9]\\d*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "materialFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "coordinates": {
              "type": "string",
              "const": "absolute-source-pixels"
            },
            "cells": {
              "type": "array",
