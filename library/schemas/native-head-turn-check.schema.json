                  "review": {
                    "type": "string",
                    "enum": [
                      "unreviewed",
                      "needs-redraw",
                      "candidate"
                    ],
                    "default": "unreviewed"
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 2000,
                    "default": ""
                  }
                },
                "required": [
                  "index"
                ],
                "additionalProperties": false
              },
              "minItems": 16,
              "maxItems": 16
            },
            "approved": {
              "type": "boolean",
              "const": false
            },
            "registered": {
              "type": "boolean",
              "const": false
            },
            "productionReady": {
              "type": "boolean",
              "const": false
            },
            "motionVerified": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "version",
            "actor",
            "file",
            "sha256",
            "materialFingerprint",
            "width",
            "height",
            "coordinates",
            "cells",
            "approved",
            "registered",
            "productionReady",
            "motionVerified"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "draft"
      ],
      "additionalProperties": false
    }
