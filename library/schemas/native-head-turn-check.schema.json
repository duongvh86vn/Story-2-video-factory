                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "yawDeg": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "neck": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "neckTop": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "chin": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "eyes": {
                    "type": "object",
                    "properties": {
                      "screen-left": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "visible": {
                                "type": "boolean",
                                "const": true
                              },
                              "center": {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "visible",
                              "center"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "visible": {
                                "type": "boolean",
                                "const": false
                              },
                              "occludedBy": {
                                "type": "string",
                                "enum": [
                                  "nose",
                                  "face-contour",
                                  "hair"
                                ]
                              }
                            },
                            "required": [
                              "visible",
                              "occludedBy"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "screen-right": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "visible": {
                                "type": "boolean",
                                "const": true
                              },
                              "center": {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
