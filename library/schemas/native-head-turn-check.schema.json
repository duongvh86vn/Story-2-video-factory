                                  "y": {
                                    "type": "number",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "visible",
                              "center"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "visible": {
                                "type": "boolean",
                                "const": false
                              },
                              "occludedBy": {
                                "type": "string",
                                "enum": [
                                  "nose",
                                  "face-contour",
                                  "hair"
                                ]
                              }
                            },
                            "required": [
                              "visible",
                              "occludedBy"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "nose": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "mouth": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "faceContour": {
                    "type": "array",
