{
  "$ref": "#/definitions/story",
  "definitions": {
    "story": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string",
          "default": "documentary"
        },
        "language": {
          "type": "string",
          "default": "vi"
        },
        "story": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "default": ""
        },
        "style": {
          "type": "object",
          "properties": {
            "visual": {
              "type": "string"
            },
            "era": {
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "visual"
          ],
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "immutableTraits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "mutableTraits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "name",
              "description"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "fact",
                  "interpretation",
                  "visualization"
                ]
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "claim",
              "type",
              "source"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "chronology": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "causalChain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "origin": {
          "type": "string",
          "enum": [
            "narration",
            "source"
          ]
        },
        "authoring": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "factual",
                "fiction"
              ]
            },
            "identity": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "sourcePath": {
              "type": "string"
            },
            "factualVerification": {
              "type": "string",
              "const": "not-independently-verified"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "identity",
            "title",
            "sourcePath",
            "factualVerification",
            "warnings"
          ],
          "additionalProperties": false
        },
        "supplement": {
          "type": "object",
          "properties": {
            "story": {
              "type": "string"
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claim": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "interpretation",
                      "visualization"
                    ]
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "claim",
                  "type",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "sourcePath": {
              "type": "string"
            }
          },
          "required": [
            "story",
            "facts",
            "sourcePath"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "story",
        "style"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
