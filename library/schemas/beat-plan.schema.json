{
  "$ref": "#/definitions/beat-plan",
  "definitions": {
    "beat-plan": {
      "type": "object",
      "properties": {
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "visualGoal": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "segmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "meaning",
              "visualGoal",
              "importance",
              "segmentIds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "beats"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
