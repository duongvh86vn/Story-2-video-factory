{
  "$ref": "#/definitions/review",
  "definitions": {
    "review": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shotId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "type": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "description": {
                "type": "string"
              },
              "repair": {
                "type": "string"
              }
            },
            "required": [
              "shotId",
              "type",
              "severity",
              "description",
              "repair"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "vision",
            "rule-based",
            "combined"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "pass",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
