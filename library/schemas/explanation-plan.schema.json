                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "to": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "sequence",
                        "cause",
                        "transfer",
                        "part-of",
                        "compare"
                      ]
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "narration",
                              "source"
                            ]
                          },
                          "segmentId": {
                            "type": "string",
                            "maxLength": 96,
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "kind",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "kind",
                    "sourceRefs"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 16
              },
              "visualMethod": {
                "type": "string",
                "enum": [
                  "question",
                  "mechanism",
                  "process",
                  "evolution",
                  "comparison",
                  "breakdown",
                  "event-sequence",
                  "summary"
                ]
              },
              "hostIntent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sceneIntent": {
                "type": "object",
                "properties": {
                  "participants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "maxLength": 96,
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "role": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "identity": {
                          "type": "string",
                          "enum": [
                            "historical",
                            "fictional",
                            "illustrative"
                          ]
                        },
                        "sourceRefs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "narration",
                                  "source"
                                ]
                              },
                              "segmentId": {
                                "type": "string",
                                "maxLength": 96,
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                              },
                              "quote": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                              }
                            },
                            "required": [
                              "kind",
                              "quote"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "role",
                        "identity",
                        "sourceRefs"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 8
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "objective": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "sourceRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "narration",
                            "source"
                          ]
                        },
                        "segmentId": {
                          "type": "string",
                          "maxLength": 96,
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "kind",
                        "quote"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "acting": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "participantId": {
                          "type": "string",
                          "maxLength": 96,
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                        },
                        "movement": {
                          "type": "string",
                          "enum": [
                            "walk",
                            "jump"
                          ]
                        },
                        "operation": {
                          "type": "string",
                          "enum": [
                            "contact",
                            "pick-place",
                            "carry",
                            "drop"
                          ]
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "locomotion",
                            "manipulation",
                            "posture",
                            "observation",
                            "indication",
                            "speech",
                            "reaction",
                            "hold",
                            "unsupported"
                          ]
                        },
                        "statement": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "sourceRefs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "narration",
                                  "source"
                                ]
                              },
                              "segmentId": {
                                "type": "string",
                                "maxLength": 96,
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                              },
                              "quote": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                              }
                            },
                            "required": [
                              "kind",
                              "quote"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        },
                        "targetIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 96,
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                          },
                          "minItems": 1,
                          "maxItems": 8
                        }
                      },
                      "required": [
                        "participantId",
                        "kind",
                        "statement",
                        "sourceRefs"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 16
                  }
                },
                "required": [
                  "participants",
                  "action",
                  "objective",
                  "sourceRefs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "beatId",
              "explanationGoal",
              "narrationSegmentIds",
              "sourceRefs",
              "entities",
              "relations",
              "visualMethod",
              "hostIntent"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "contentIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "description": {
                "type": "string"
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "narration",
                        "source"
                      ]
                    },
                    "segmentId": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "severity",
              "description",
              "sourceRefs"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "version",
        "hostId",
        "beats"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
