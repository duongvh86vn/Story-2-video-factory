{
  "$ref": "#/definitions/explanation-plan",
  "definitions": {
    "explanation-plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 2
        },
        "hostId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beatId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "explanationGoal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "narrationSegmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "minItems": 1
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "narration",
                        "source"
                      ]
                    },
                    "segmentId": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "Canonical semantic name: copy one contiguous excerpt from a verified sourceRef.quote. Do not compose, paraphrase or title-case a new description. Decorative display text belongs in artwork."
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "boiler",
                        "condenser",
                        "piston",
                        "cylinder",
                        "wheel",
                        "gear",
                        "lever",
                        "car",
                        "engine",
                        "battery",
                        "pipe",
                        "flow",
                        "object",
                        "stage",
                        "marker"
                      ]
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "narration",
                              "source"
                            ]
                          },
                          "segmentId": {
                            "type": "string",
                            "maxLength": 96,
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "kind",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "configuration": {
                      "type": "string",
                      "enum": [
                        "old-cylinder",
                        "separate-condenser"
                      ],
                      "description": "Only for a sourced grouped design: kind=object, visualization type=comparison, exact canonical label and evidence. Omit on cylinder/condenser components. Preserve seed entity identity and states."
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "enum": [
                              "hot",
                              "cold"
                            ]
                          },
                          "sourceRefs": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "narration",
                                    "source"
                                  ]
                                },
                                "segmentId": {
                                  "type": "string",
                                  "maxLength": 96,
                                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                                },
                                "quote": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2000
                                }
                              },
                              "required": [
                                "kind",
                                "quote"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1
                          }
                        },
                        "required": [
                          "value",
                          "sourceRefs"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 8
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "sourceRefs"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "relations": {
                "type": "array",
