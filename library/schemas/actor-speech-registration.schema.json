{
  "$ref": "#/definitions/actor-speech-registration",
  "definitions": {
    "actor-speech-registration": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "actor-speech-registration-1"
        },
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "motionId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "motionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 20,
          "default": []
        }
      },
      "required": [
        "version",
        "id",
        "motionId",
        "motionFingerprint",
        "regions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
