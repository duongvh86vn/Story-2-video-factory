{
  "$ref": "#/definitions/native-head-turn-prompt",
  "definitions": {
    "native-head-turn-prompt": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "enum": [
            "lila",
            "karo"
          ]
        },
        "provider": {
          "type": "string",
          "const": "builtin-imagegen"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "referenceImages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary-character-identity",
                  "edit-target"
                ]
              }
            },
            "required": [
              "file",
              "sha256",
              "role"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2
        },
        "generatedOriginal": {
          "type": "string",
          "minLength": 1
        },
        "requestedYawDeg": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "minItems": 16,
          "maxItems": 16
        },
        "requestedRepairCells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "maxItems": 16
        },
        "scope": {
          "type": "string",
          "const": "static-art-authoring-only"
        },
        "approved": {
          "type": "boolean",
          "const": false
        },
        "registered": {
          "type": "boolean",
          "const": false
        },
        "productionReady": {
          "type": "boolean",
          "const": false
        },
        "runtimeVerified": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "actor",
        "provider",
        "prompt",
        "referenceImages",
        "generatedOriginal",
        "requestedYawDeg",
        "requestedRepairCells",
        "scope",
        "approved",
        "registered",
        "productionReady",
        "runtimeVerified"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
