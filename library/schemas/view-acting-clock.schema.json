{
  "$ref": "#/definitions/view-acting-clock",
  "definitions": {
    "view-acting-clock": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "native-view-acting-clock-2"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "runStartMs": {
          "type": "integer",
          "minimum": 0
        },
        "runEndMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sourceIdentityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gazes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "target": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "startMs",
              "endMs",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "gestures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "point",
                  "think"
                ]
              },
              "hand": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "target": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "elbowPole": {
                "type": "string",
                "enum": [
                  "rest",
                  "reach"
                ]
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "reachMs": {
                "type": "number",
                "minimum": 0
              },
              "recoverMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "action",
              "hand",
              "startMs",
              "endMs",
              "reachMs",
              "recoverMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "ownerId",
        "startMs",
        "endMs",
        "runStartMs",
        "runEndMs",
        "sourceIdentityHash",
        "gazes",
        "gestures"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
