{
  "$ref": "#/definitions/view-acting-clock",
  "definitions": {
    "view-acting-clock": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "native-view-acting-clock-3"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "runStartMs": {
          "type": "integer",
          "minimum": 0
        },
        "runEndMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sourceIdentityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gazes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "target": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "startMs",
              "endMs",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "gestures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "point",
                  "think"
                ]
              },
              "hand": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "target": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "elbowPole": {
                "type": "string",
                "enum": [
                  "rest",
                  "reach"
                ]
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "reachMs": {
                "type": "number",
                "minimum": 0
              },
              "recoverMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "action",
              "hand",
              "startMs",
              "endMs",
              "reachMs",
              "recoverMs"
            ],
            "additionalProperties": false
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "mood": {
                "type": "string",
                "enum": [
                  "neutral",
                  "curious",
                  "thinking",
                  "concerned",
                  "effort",
                  "surprised",
                  "understanding",
                  "confident",
                  "happy",
                  "sad",
                  "angry",
                  "afraid",
                  "excited",
                  "disappointed",
                  "relieved",
                  "tired"
                ]
              }
            },
            "required": [
              "startMs",
              "endMs",
              "mood"
            ],
            "additionalProperties": false
          }
        },
        "bodyMotion": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "native-source-body-1"
            },
            "id": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
            },
            "startMs": {
              "type": "integer",
              "minimum": 0
            },
            "endMs": {
              "type": "integer",
              "minimum": 0
            },
            "walks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "endMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fromX": {
                    "type": "number"
                  },
                  "toX": {
                    "type": "number"
                  },
                  "gait": {
                    "type": "string",
                    "enum": [
                      "walk",
                      "run"
                    ]
                  }
                },
                "required": [
                  "startMs",
                  "endMs",
                  "fromX",
                  "toX"
                ],
                "additionalProperties": false
              }
            },
            "jumps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "endMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "takeoffMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "landingMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tuck": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.5
                  }
                },
                "required": [
                  "startMs",
                  "endMs",
                  "takeoffMs",
                  "landingMs",
                  "height"
                ],
                "additionalProperties": false
              },
              "maxItems": 16
            },
            "postures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "endMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pose": {
                    "type": "string",
                    "enum": [
                      "stand",
                      "crouch",
                      "lean",
                      "seated"
                    ]
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "leanDeg": {
                    "type": "number",
                    "minimum": -25,
                    "maximum": 25
                  },
                  "supportId": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                  }
                },
                "required": [
                  "startMs",
                  "endMs",
                  "pose"
                ],
                "additionalProperties": false
              }
            },
            "entryPosture": {
              "type": "object",
              "properties": {
                "pose": {
                  "type": "string",
                  "enum": [
                    "stand",
                    "crouch",
                    "lean",
                    "seated"
                  ]
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "leanDeg": {
                  "type": "number",
                  "minimum": -25,
                  "maximum": 25
                },
                "supportId": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                }
              },
              "required": [
                "pose"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "id",
            "startMs",
            "endMs",
            "walks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "ownerId",
        "startMs",
        "endMs",
        "runStartMs",
        "runEndMs",
        "sourceIdentityHash",
        "gazes",
        "gestures"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
