{
  "$ref": "#/definitions/project-state",
  "definitions": {
    "project-state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "specVersion": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "NEW",
            "INGESTED",
            "TIMED",
            "ANALYZED",
            "STORYBOARDED",
            "ASSETS_READY",
            "SCENES_READY",
            "DRAFT_RENDERED",
            "REVIEWED",
            "REPAIRED",
            "FINAL_RENDERED",
            "QC_PASSED",
            "DONE"
          ]
        },
        "updatedAt": {
          "type": "string"
        },
        "inputHash": {
          "type": "string"
        },
        "narrationInputHash": {
          "type": "string",
          "default": ""
        },
        "hostInputHash": {
          "type": "string",
          "default": ""
        },
        "assetInputHash": {
          "type": "string",
          "default": ""
        },
        "artifactHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "reviewIteration": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "approvals": {
          "type": "object",
          "properties": {
            "storyboard": {
              "type": "boolean",
              "default": false
            },
            "characters": {
              "type": "boolean",
              "default": false
            },
            "host": {
              "type": "boolean",
              "default": false
            },
            "hostHash": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "locked": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        },
        "waitingFor": {
          "type": "string",
          "enum": [
            "host-approval",
            "characters-approval",
            "storyboard-approval",
            "voice",
            "source-review",
            "script",
            "art-direction"
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "name",
        "state",
        "updatedAt",
        "inputHash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
