{
  "$ref": "#/definitions/actor-motion",
  "definitions": {
    "actor-motion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "actor-motion-1"
        },
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "actorId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "state": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "view": {
          "type": "string",
          "enum": [
            "front",
            "back",
            "left",
            "right",
            "three-quarter-left",
            "three-quarter-right",
            "back-three-quarter-left",
            "back-three-quarter-right"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "sprite-gen-atlas",
                "sprite-gen-strip"
              ]
            },
            "metadataHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sheetHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "registrationHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "referenceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "loop": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "metadataHash",
            "sheetHash",
            "registrationHash",
            "referenceHash",
            "loop"
          ],
          "additionalProperties": false
        },
        "sheet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 32768
            }
          },
          "required": [
            "path",
            "hash",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "playback": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "once",
                "loop"
              ]
            },
            "end": {
              "type": "string",
              "enum": [
                "hold",
                "first",
                "hide"
              ]
            }
          },
          "required": [
            "mode",
            "end"
          ],
          "additionalProperties": false
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "w": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "durationMs": {
                "type": "number",
                "minimum": 1,
                "maximum": 60000
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "landmarks": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "rect",
              "durationMs",
              "anchor",
              "landmarks"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "candidate"
            },
            "productionReady": {
              "type": "boolean",
              "const": false
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 32
            }
          },
          "required": [
            "status",
            "productionReady",
            "warnings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "actorId",
        "state",
        "view",
        "fingerprint",
        "source",
        "sheet",
        "playback",
        "frames",
        "review"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
