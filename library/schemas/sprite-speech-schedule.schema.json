{
  "$ref": "#/definitions/sprite-speech-schedule",
  "definitions": {
    "sprite-speech-schedule": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "sprite-speech-clock-1"
        },
        "slot": {
          "type": "object",
          "properties": {
            "shotStartMs": {
              "type": "number",
              "minimum": 0
            },
            "startMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 120000
            },
            "endMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 120000
            },
            "segmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "minItems": 1,
              "maxItems": 128
            }
          },
          "required": [
            "shotStartMs",
            "startMs",
            "endMs",
            "segmentIds"
          ],
          "additionalProperties": false
        },
        "synchronization": {
          "type": "string",
          "enum": [
            "audio-activity",
            "segment-draft"
          ]
        },
        "audioHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "narrationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "activityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 120000
              },
              "endMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 120000
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "maxItems": 6000
        }
      },
      "required": [
        "version",
        "slot",
        "synchronization",
        "narrationHash",
        "activityHash",
        "intervals"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
