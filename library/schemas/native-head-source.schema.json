{
  "$ref": "#/definitions/native-head-source",
  "definitions": {
    "native-head-source": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "native-head-source-1"
        },
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "bankFingerprint": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "cell": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              }
            },
            "required": [
              "atMs",
              "cell"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 600
        }
      },
      "required": [
        "version",
        "id",
        "ownerId",
        "bankFingerprint",
        "startMs",
        "endMs",
        "samples"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
