{
  "$ref": "#/definitions/asset-manifest",
  "definitions": {
    "asset-manifest": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "local",
                  "user",
                  "code",
                  "stock",
                  "archive",
                  "generated",
                  "template"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "approved",
                  "missing",
                  "pending"
                ]
              },
              "hash": {
                "type": "string"
              },
              "requestHash": {
                "type": "string"
              },
              "shotIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "default": []
              },
              "characterId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "versionId": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "pose": {
                "type": "string"
              },
              "sourceUrl": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "retrievedAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "path",
              "source",
              "status",
              "hash"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
