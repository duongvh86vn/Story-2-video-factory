{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "outDir": "dist", "rootDir": ".",
    "sourceMap": true, "declaration": true, "noUncheckedIndexedAccess": true
  },
  "include": ["apps/cli/**/*.ts", "apps/server/**/*.ts", "packages/**/*.ts", "benchmarks/**/*.ts"],
  "exclude": ["node_modules", "dist", "projects", "apps/studio"]
}
